{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!t/|og/|people/|examples/|assets/|robots.txt|sitemap.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/og/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/people/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
